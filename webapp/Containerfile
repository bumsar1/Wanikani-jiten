# Builds with podman or docker: `podman build -t wkjiten -f webapp/Containerfile .`
# Build context is the repository root, because the app imports wkjiten.py.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    WKJITEN_DB=/data/wkjiten.sqlite3 \
    WKJITEN_SECRET_FILE=/data/secret.key

WORKDIR /app

COPY webapp/requirements.txt /app/webapp/requirements.txt
RUN pip install --no-cache-dir -r /app/webapp/requirements.txt gunicorn

COPY wkjiten.py /app/wkjiten.py
COPY assets/ /app/assets/
COPY webapp/ /app/webapp/

# Runs unprivileged. /data is the only thing that needs to persist.
RUN useradd --system --uid 10001 --home /app wkjiten \
    && mkdir -p /data && chown -R wkjiten:wkjiten /app /data
USER wkjiten
VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=60s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/healthz',timeout=4)"

# Threads rather than processes: the work is waiting on WaniKani and Jiten, and
# a single process keeps the in-flight refresh guard meaningful.
CMD ["gunicorn", "--chdir", "/app/webapp", "--bind", "0.0.0.0:8080", \
     "--workers", "1", "--threads", "8", "--timeout", "180", "app:app"]
